# Packages (lines beginning "#" are comments)
 &PACKAGES
 useMNC         = .FALSE.,
 useDiagnostics = .TRUE.,
# GM/Redi in the forward sweep since 2026-09-11, as in the spin-up and the forward legs (input/data.pkg;
# data.gmredi is a copy of input/data.gmredi). data.autodiff keeps it out of the adjoint sweep
# (useGMRediInAdMode=.FALSE.), where its linearisation blows up within days (stability_study, 31236). Only
# the approxAdv and ckpAll builds honour that split; the submit body refuses a -nocheckpoint build with it.
# The GM-free configuration before that date is variants/baseline/*_gmOff.
 useGMRedi      = .TRUE.,
 useKPP         = .FALSE.,
# grdchk off for the kappa_v ensemble: at its current check point it measures
# noise, not the gradient, and costs ~2.6x the adjoint proper. The ensemble's
# own finite-difference comparison is the real validation.
 useGrdchk      = .FALSE.,
 &
