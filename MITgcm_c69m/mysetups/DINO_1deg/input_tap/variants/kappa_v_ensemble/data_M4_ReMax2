 delR = 10.139,
    10.454, 10.836, 11.297, 11.854, 12.527, 13.340, 14.322, 15.507, 16.936,
    18.658, 20.733, 23.231, 26.233, 29.838, 34.160, 39.331, 45.505, 52.857,
    61.583, 71.901, 84.049, 98.276, 114.835, 133.974, 152.596, 170.824, 192.859,
    219.493, 251.677, 290.561, 337.525, 394.227, 462.659, 545.203, 600.0,
