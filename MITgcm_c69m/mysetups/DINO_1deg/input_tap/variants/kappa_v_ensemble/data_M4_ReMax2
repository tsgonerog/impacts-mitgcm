# Ensemble member M4 under the 2026-09-10 production configuration: kappa_v = 4.8e-05 m2/s (4 x reference
# 1.2e-05). 5-yr adjoint 2180 -> 2185 from the pickup the member's forward leg (data_M4_ReMax2 under
# input/variants/kappa_v_ensemble/) writes at 3162240; IMPACTS_PICKUP_RUN_DIR must point at that run.
# Identical to the live input_tap/data (scheme 33 forward sweep, reference viscosity + viscAhReMax=2.;
# the live data.autodiff supplies useApproxAdvectionInAdMode for the scheme-30 adjoint sweep) apart from
# diffKrT/diffKrS. The 2026-08 member data_M4 is the visc2x predecessor.
# Since 2026-09-10 (later the same day) the vertical tracer advection is EXPLICIT (tempImplVertAdv=
# saltImplVertAdv=.FALSE.): the implicit form of the flux-limited DST3 blew up two kappa-ensemble legs
# (8x and 16x) within two years by producing a +-100 K checkerboard in a convectively homogenised column
# (runs 31191/31193, diagnosed with 31198-31201; stability_study README); the explicit form, DINO's own
# choice, survives, and the vertical CFL here is below 0.05.
# Model parameters
# Continuous equation parameters
 &PARM01
# --- Lateral Viscosity and Diffusivity (scaled to equatorial ~111km) ---
# (1/2 * 0.27 m/s * 111,000 m)
# viscAh=15000.,
# (1/2 * 0.027 m/s * 111,000 m)
 diffKhT=500.,
 diffKhS=500.,
# --- Vertical Mixing Parameters ---
 viscAr=1.2E-4,
# background vertical diffusivity (DINO's rn_avt0). Under ALLOW_3D_DIFFKR
# (code*/CPP_OPTIONS.h) it initialises the 3-D diffKr array (ini_mixing.F)
# that the xx_diffkr control perturbs; until 2026-09-09 the same constant
# was read as a field from diffKrFile='dino_diffKr.bin'
 diffKrT=4.8E-5,
 diffKrS=4.8E-5,
 no_slip_sides=.FALSE.,
 no_slip_bottom=.FALSE.,
 bottomDragQuadratic = 3.0E-3
# comment out when kpp true
 ivdc_kappa=100.,
 implicitViscosity=.TRUE.,
 implicitDiffusion=.TRUE.,
 eosType='JMD95P',
#
 tRef =
     3*23., 3*22., 21., 2*20., 19., 2*18., 17., 2*16., 15.,
     14., 13., 12., 11., 2*9., 8., 7., 2*6., 2*5., 3*4.,
     3*3., 2*2.,
 sRef = 36*35.0,
 tAlpha=2.E-4,
 sBeta=7.4E-4,
 rhoNil=1035.0,
 gravity=9.81,
 rigidLid=.FALSE.,
 implicitFreeSurface=.TRUE.,
 exactConserv=.TRUE.,
# hFacMin=0.1,
#
 tempStepping=.TRUE.,
 saltStepping=.TRUE.,
 tempAdvection=.TRUE.,
 saltAdvection=.TRUE.,
 tempAdvScheme=33,
 saltAdvScheme=33,
 staggerTimeStep=.TRUE.,
 tempImplVertAdv=.FALSE.,
 saltImplVertAdv=.FALSE.,
# 
 useSingleCpuIO=.TRUE.,
 vectorInvariantMomentum=.TRUE.,
# viscAhReMax: a floor A >= |u| dx / 2, DINO's own Re_dx = 2 criterion with the local
# speed -- the reference file wherever |u| < 0.27 m/s, raised only in the jets (2026-09-09).
 viscAhReMax=2.,
 readBinaryPrec=64,
 writeBinaryPrec=32,
 debugLevel=1,
 &

# Elliptic solver parameters
 &PARM02
 cg2dTargetResidual=1.E-7,
 cg2dMaxIters=1000,
 &

# Time stepping parameters
 &PARM03
 nIter0=3162240,
 nTimeSteps=87840,
 deltaT=1800.,
 pChkptFreq=2635200.,
 chkptFreq=155520000.,
 dumpFreq=31104000.,
 monitorFreq=432000.,
 monitorSelect=2,
 tauThetaClimRelax=561600.0,
 tauSaltClimRelax=561600.0,
 periodicExternalForcing=.TRUE.,
 externForcingPeriod=86400.,
 externForcingCycle=31536000.,
#-adjMonitorFreq ==> monitors adj information inside STDOUT.0000 (or inside output_tap_adj.txt file for serial run)
 adjMonitorFreq=432000.,
#-adjDumpFreq ==> spit out adj fields along the way e.g., ADJTheta.0000000000.data
 adjDumpFreq=432000.,
#-for longer run (100 yrs)
# endTime = 3110400000.,
# monitorFreq=2592000.,
 &

# Gridding parameters
