# Sub-monthly sampling check of the overturning (2026-09-16).
#
# WHY. Every DINO forward run writes its dynDiag stream as a 30.5-day TIME AVERAGE
# (data.diagnostics frequency(2)=2635200.), so the AMOC series drawn from the
# 200-year spin-ups is a series of monthly means and says nothing about what
# happens inside a month. The slide deck
# impacts-notes/references/dino_adjoint_sensitivities/slides reports 0.003 Sv of
# month-to-month change at 26N in the current setup, and the question is whether
# the ocean really is that steady or the averaging hides the variability.
#
# WHAT THIS RUNS. One model year from the year-190 pickup of the production
# spin-up 31203, under the live input/data physics, with VVEL written three ways
# at once (data.diagnostics_from190yrPk_viscRef_ReMax2_dailyDiag): 30.5-day means, daily
# means and 6-hourly snapshots. Comparing the three answers the question
# directly: if the 6-hourly series has the same range as the monthly one, the
# averaging removes nothing.
#
# Only nIter0 and the checkpoint frequencies differ from the live input/data.
# pChkptFreq and chkptFreq are ZERO ON PURPOSE: submit_frd.sh symlinks the
# pickup it starts from into the run directory, and a run that writes a pickup
# under a name it also links writes THROUGH the symlink into the source run --
# which is how 31203 overwrote 30983's year-170 pickup on 2026-09-11. This run
# needs no pickup of its own, so it writes none.
#
#     IMPACTS_TEST_CASE=variability_check/from190yrPk_viscRef_ReMax2_dailyDiag \
#     IMPACTS_PICKUP_RUN_DIR=$SCRATCH_ROOT/DINO_1deg_outputs/runs/forward/spinup_200yr_viscRef_ReMax2/DINO_1deg_frd_200yr_from_rest_viscRef_ReMax2_run31203 \
#     IMPACTS_PICKUP_ITER=3337920 IMPACTS_DURATION_DAYS=366 IMPACTS_MONITOR_FREQ_DAYS=1 \
#     ../../../tools/submit.sh scripts/submit_frd.sh
#
# Model parameters
# Continuous equation parameters
 &PARM01
# --- Lateral Viscosity and Diffusivity (scaled to equatorial ~111km) ---
# (1/2 * 0.27 m/s * 111,000 m)
# viscAh=15000.,
# (1/2 * 0.027 m/s * 111,000 m)
 diffKhT=500.,
 diffKhS=500.,
# --- Vertical Mixing Parameters ---
 viscAr=1.2E-4,
# background vertical diffusivity (DINO's rn_avt0). Under ALLOW_3D_DIFFKR
# (code*/CPP_OPTIONS.h) it initialises the 3-D diffKr array (ini_mixing.F)
# that the xx_diffkr control perturbs; until 2026-09-09 the same constant
# was read as a field from diffKrFile='dino_diffKr.bin'
 diffKrT=1.2E-5,
 diffKrS=1.2E-5,
 no_slip_sides=.FALSE.,
 no_slip_bottom=.FALSE.,
 bottomDragQuadratic = 3.0E-3
# comment out when kpp true
 ivdc_kappa=100.,
 implicitViscosity=.TRUE.,
 implicitDiffusion=.TRUE.,
 eosType='JMD95P',
#
 tRef =
     3*23., 3*22., 21., 2*20., 19., 2*18., 17., 2*16., 15.,
     14., 13., 12., 11., 2*9., 8., 7., 2*6., 2*5., 3*4.,
     3*3., 2*2.,
 sRef = 36*35.0,
 tAlpha=2.E-4,
 sBeta=7.4E-4,
 rhoNil=1035.0,
 gravity=9.81,
 rigidLid=.FALSE.,
 implicitFreeSurface=.TRUE.,
 exactConserv=.TRUE.,
# hFacMin=0.1,
#
 tempStepping=.TRUE.,
 saltStepping=.TRUE.,
 tempAdvection=.TRUE.,
 saltAdvection=.TRUE.,
 tempAdvScheme=33,
 saltAdvScheme=33,
 staggerTimeStep=.TRUE.,
 tempImplVertAdv=.FALSE.,
 saltImplVertAdv=.FALSE.,
# 
 useSingleCpuIO=.TRUE.,
 vectorInvariantMomentum=.TRUE.,
# viscAhReMax: a floor A >= |u| dx / 2, DINO's own Re_dx = 2 criterion with the local
# speed -- the reference file wherever |u| < 0.27 m/s, raised only in the jets (2026-09-09).
 viscAhReMax=2.,
 readBinaryPrec=64,
 writeBinaryPrec=32,
 debugLevel=1,
 &

# Elliptic solver parameters
 &PARM02
 cg2dTargetResidual=1.E-7,
