Subject: [PATCH] Implement the ADEXCH adjoint halo exchanges of pkg/tapenade

Generated from MITgcm_c69m/mods_tapenade_hooks/ against the tree at
MITgcm_c69m/MITgcm (checkpoint69m) by check_against_tree.sh.
Apply from the tree's root with: git apply -p1 0001-implement-the-adexch-adjoint-halo-exchanges-of-pkg-tapenade.patch

--- a/pkg/tapenade/stubs_tap_adj.F
+++ b/pkg/tapenade/stubs_tap_adj.F
@@ -9,6 +9,23 @@
 C--    *_D: tlm
 C--    *_FWD, *_BWD: adjoint with no checkpointing
 C--
+C--   The five ADEXCH_* routines implement the adjoint halo exchanges that
+C--   pkg/autodiff applies to an adjoint field before writing it, to fold
+C--   the tile-overlap contributions into the interior points that own them
+C--   (called from addummy_in_stepping.F, copy_ad_uv_outp.F, monitor_ad.F
+C--   and the Tapenade output hooks in dummy_tap.F). They used to be no-op
+C--   stubs, which left partial sums pinned to every internal tile edge of
+C--   a dumped adjoint field on a multi-tile decomposition. Each one now
+C--   composes, in reverse order, the *_AD twins of the exchanges its
+C--   forward counterpart calls (EXCH2_R{L,S}{1,2}_CUBE_AD with pkg/exch2,
+C--   the EXCH1_*_AD family otherwise), mirroring eesupp/src/exch_3d_rl.F,
+C--   exch_uv_3d_rl.F, exch_xy_rs.F, exch_uv_xy_rs.F and exch_xy_rl.F.
+C--   Two limitations: the cubed-sphere corner fix-ups of the forward UV
+C--   wrappers (pkg/exch2/exch2_uv_3d_rl.F, active only under
+C--   useCubedSphereExchange) are not adjointed, so the fold is incomplete
+C--   next to facet corners; and under DISCONNECTED_TILES the forward
+C--   exchange (EXCH0_*) has no adjoint counterpart, so no fold is applied.
+C--
 C--    Contents:
 C--    o  GLOBAL_MAX_R8_B
 C--    o  GLOBAL_SUM_TILE_RL_B
@@ -145,51 +162,187 @@
       END
 
 C---+----1----+----2----+----3----+----4----+----5----+----6----+----7-|--+----|
-      SUBROUTINE ADEXCH_3D_RL( adVar, Nr, myThid )
+C     Adjoint halo exchange of a 3-D _RL centered (tracer-point) field:
+C     tile-overlap adjoint values are added into the interior points that
+C     own them, then zeroed (the transpose of the forward halo copy).
+C     Mirrors EXCH_3D_RL / EXCH2_3D_RL with each exchange replaced by its
+C     _AD twin, composed in reverse order (corners first).
+      SUBROUTINE ADEXCH_3D_RL( adVar, myNz, myThid )
       IMPLICIT NONE
-      _RL    adVar
-      INTEGER Nr
+#include "SIZE.h"
+#include "EEPARAMS.h"
+      INTEGER myNz
+      _RL     adVar( 1-OLx:sNx+OLx, 1-OLy:sNy+OLy, myNz, nSx, nSy )
       INTEGER myThid
-      WRITE(*,*) "Called not yet defined"
+
+#ifdef ALLOW_EXCH2
+      CALL EXCH2_RL1_CUBE_AD( adVar, .FALSE., 'T ',
+     I            OLx, OLx, OLy, OLy, myNz,
+     I            OLx, OLy, EXCH_UPDATE_CORNERS, myThid )
+      CALL EXCH2_RL1_CUBE_AD( adVar, .FALSE., 'T ',
+     I            OLx, OLx, OLy, OLy, myNz,
+     I            OLx, OLy, EXCH_IGNORE_CORNERS, myThid )
+#else /* ALLOW_EXCH2 */
+      IF ( useCubedSphereExchange ) THEN
+        CALL EXCH1_RL_CUBE_AD( adVar, .FALSE.,
+     I            OLx, OLx, OLy, OLy, myNz,
+     I            OLx, OLy, EXCH_UPDATE_CORNERS, myThid )
+      ELSE
+# ifndef DISCONNECTED_TILES
+        CALL EXCH1_RL_AD( adVar,
+     I            OLx, OLx, OLy, OLy, myNz,
+     I            OLx, OLy, EXCH_UPDATE_CORNERS, myThid )
+# endif
+      ENDIF
+#endif /* ALLOW_EXCH2 */
       RETURN
       END
 
 C---+----1----+----2----+----3----+----4----+----5----+----6----+----7-|--+----|
-      SUBROUTINE ADEXCH_UV_XY_RS( adU, adV, bool, myThid )
+C     Adjoint halo exchange of a 2-D _RS C-grid vector pair (e.g. wind
+C     stress adjoints).  Mirrors EXCH_UV_XY_RS; see ADEXCH_UV_3D_RL for
+C     the cubed-sphere caveat.
+      SUBROUTINE ADEXCH_UV_XY_RS( adU, adV, withSigns, myThid )
       IMPLICIT NONE
-      _RS     adU, adV
-      LOGICAL bool
-      INTEGER myThid
-      WRITE(*,*) "Called not yet defined"
+#include "SIZE.h"
+#include "EEPARAMS.h"
+      _RS     adU( 1-OLx:sNx+OLx, 1-OLy:sNy+OLy, nSx, nSy )
+      _RS     adV( 1-OLx:sNx+OLx, 1-OLy:sNy+OLy, nSx, nSy )
+      LOGICAL withSigns
+      INTEGER myThid
+
+#ifdef ALLOW_EXCH2
+      CALL EXCH2_RS2_CUBE_AD( adU, adV, withSigns, 'Cg',
+     I            OLx, OLx, OLy, OLy, 1,
+     I            OLx, OLy, EXCH_UPDATE_CORNERS, myThid )
+      CALL EXCH2_RS2_CUBE_AD( adU, adV, withSigns, 'Cg',
+     I            OLx, OLx, OLy, OLy, 1,
+     I            OLx, OLy, EXCH_IGNORE_CORNERS, myThid )
+#else /* ALLOW_EXCH2 */
+      IF ( useCubedSphereExchange ) THEN
+        CALL EXCH1_UV_RS_CUBE_AD( adU, adV, withSigns,
+     I            OLx, OLx, OLy, OLy, 1,
+     I            OLx, OLy, EXCH_UPDATE_CORNERS, myThid )
+      ELSE
+# ifndef DISCONNECTED_TILES
+        CALL EXCH1_RS_AD( adV,
+     I            OLx, OLx, OLy, OLy, 1,
+     I            OLx, OLy, EXCH_UPDATE_CORNERS, myThid )
+        CALL EXCH1_RS_AD( adU,
+     I            OLx, OLx, OLy, OLy, 1,
+     I            OLx, OLy, EXCH_UPDATE_CORNERS, myThid )
+# endif
+      ENDIF
+#endif /* ALLOW_EXCH2 */
       RETURN
       END
 
