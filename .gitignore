# Claude Code local settings (permissions etc.) - machine-specific
.claude/settings.local.json

# Match any directory named exactly 'build' at any depth
**/build/

# Match any directory that starts with 'build' (e.g., build_test, build_upd)
**/build*/

# ...but NOT MITgcm's build_options/, which is upstream source, not a build
# directory. The rule above was swallowing all 95 genmake2 optfiles, so a fresh
# clone had none and could not build on any machine. A negation only works
# because it un-excludes the directory itself; git cannot re-include a file
# inside a directory that stays excluded.
!**/build_options/

# Ignore all Jupyter Notebook checkpoints directory an any depth
**/.ipynb_checkpoints/

# Ignore large input binaries
MITgcm_c69m/mysetups/SOMA_1deg/input_binaries
MITgcm_c69m/mysetups/SOMA_1deg/input_adj_binaries/
MITgcm_c69m/mysetups/DINO_1deg/input_binaries/
MITgcm_c69m/mysetups/DINO_1deg/input_adj_binaries/

# ----------------------------------------------------------------------------
# analyses/ derived output
#
# Figures and animations now live on cluster scratch, inside the run directory
# they were computed from (see analyses/README.md). The notebooks write there
# directly. These rules are a safety net: if a cell is ever run with an output
# path that lands back in the repo, the result stays untracked instead of being
# committed by a stray `git add -A`.
# ----------------------------------------------------------------------------

analyses/**/*.png
analyses/**/*.jpg
analyses/**/*.gif
analyses/**/*.html

# Editor autosave / scratch copies (.~poster.ipynb was a corrupt 162 MB one)
analyses/**/.~*
analyses/**/*-checkpoint.ipynb

# Python bytecode (analyses/.../ensemble_common.py is imported by notebooks)
**/__pycache__/
MITgcm_c69m/mysetups/barotropic_gyre/input_binaries/
MITgcm_c69m/mysetups/barotropic_gyre/input_adj_binaries/
